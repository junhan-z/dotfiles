# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# Reference the full default set with: ghostty +show-config --default --docs

# Nord, to match configs/tmux.conf
theme = Nord

# JetBrains Mono ships inside Ghostty, so this needs no font install.
# Powerline glyphs in the tmux status bar come from the bundled
# Symbols Nerd Font fallback.
font-family = JetBrains Mono
font-size = 16

# Window
window-padding-x = 8
window-padding-y = 6
window-save-state = always
macos-titlebar-style = tabs

# Send Option as Meta instead of composing accented characters, so
# alt-based word motions reach zsh and vim.
macos-option-as-alt = true

# Cursor. Block and a 10MB scrollback are already the defaults, so only
# the two deviations are listed.
cursor-style-blink = false
mouse-hide-while-typing = true

# No confirmation dialog on close
confirm-close-surface = false

# zsh integration. The feature list is additive against the defaults, so
# turning one off takes an explicit no- prefix. "no-cursor" keeps
# cursor-style above authoritative instead of letting the shell drive it.
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# Ghostty sets TERM=xterm-ghostty. Hosts without that terminfo entry need:
#   infocmp -x | ssh HOST -- tic -x -
