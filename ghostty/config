# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# Reference the full default set with: ghostty +show-config --default --docs

# Nord, to match configs/tmux.conf
theme = Nord

# JetBrains Mono ships inside Ghostty, so this needs no font install.
# Powerline glyphs in the tmux status bar come from the bundled
# Symbols Nerd Font fallback.
font-family = JetBrains Mono
font-size = 16

# Window. padding-balance splits the leftover row/column space evenly
# instead of dumping it all at the bottom right.
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs

# Default is srgb, which leaves the Nord palette looking washed out on a
# wide-gamut display.
window-colorspace = display-p3

# The dimensions overlay on every resize is noise once the padding is set.
resize-overlay = never

# Send Option as Meta instead of composing accented characters, so
# alt-based word motions reach zsh and vim.
macos-option-as-alt = true

# Cursor. Block and a 10MB scrollback are already the defaults, so only
# the two deviations are listed.
cursor-style-blink = false
mouse-hide-while-typing = true

# No confirmation dialog on close
confirm-close-surface = false

# zsh integration. The feature list is additive against the defaults, so
# turning one off takes an explicit no- prefix. "no-cursor" keeps
# cursor-style above authoritative instead of letting the shell drive it.
#
# ssh-terminfo installs the xterm-ghostty entry on the remote host the
# first time we connect, which is what keeps TERM working over ssh.
# ssh-env is the fallback for hosts we cannot write to: it downgrades
# TERM to xterm-256color for that session rather than sending an entry
# the host does not have.
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-terminfo,ssh-env

# Global drop-down terminal. macOS asks for Accessibility permission the
# first time a global: binding is registered.
keybind = global:super+grave_accent=toggle_quick_terminal
quick-terminal-position = top

# Installed via the homebrew cask, so let brew own upgrades rather than
# having Ghostty's own updater fight it.
auto-update = off

# App icon. The frame material only applies under custom-style; the
# official icon ignores it. Ghost and screen colors are pulled from the
# Nord palette above so the icon matches the terminal.
macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = #eceff4
macos-icon-screen-color = #2e3440
